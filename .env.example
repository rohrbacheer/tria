# Copie este arquivo para backend/.env (ou exporte as variáveis) antes de rodar localmente.
# A chave NUNCA vai para o código nem para o histórico de commits.

# Chave da API do Google Gemini — gere a sua em https://aistudio.google.com/apikey
GEMINI_API_KEY=coloque_sua_chave_aqui

# Modelo do Gemini (opcional; este é o padrão)
GEMINI_MODEL=gemini-flash-lite-latest
